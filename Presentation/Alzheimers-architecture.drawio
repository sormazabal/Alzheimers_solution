<mxfile host="app.diagrams.net" type="device"><diagram name="Alzheimer's multimodal pipeline" id="alz-arch"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ui" value="&lt;span style=&quot;font-size:13px;color:#2E9BD6;&quot;&gt;&lt;b&gt;STREAMLIT CLINICAL WORKSTATION&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#FFFFFF;&quot;&gt;Clinical risk  ·  MRI records  ·  EEG records  ·  Overview  ·  Cohort&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#0E1B2E;strokeColor=#0E1B2E;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;fontFamily=Calibri" vertex="1" parent="1"><mxGeometry x="30" y="24" width="2140" height="66" as="geometry"/></mxCell><mxCell id="lane0" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#F2F5FA;strokeColor=none;strokeWidth=0;verticalAlign=middle;align=center;spacing=6;fontFamily=Calibri" vertex="1" parent="1"><mxGeometry x="30" y="118" width="1670" height="204" as="geometry"/></mxCell><mxCell id="lanetag0" value="&lt;span style=&quot;font-size:12px;color:#FFFFFF;&quot;&gt;&lt;b&gt;CLINICAL&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=26;whiteSpace=wrap;html=1;fillColor=#1B5FA8;strokeColor=none;strokeWidth=0;verticalAlign=middle;align=center;spacing=6;fontFamily=Calibri" vertex="1" parent="1"><mxGeometry x="44" y="126" width="92" height="26" as="geometry"/></mxCell><mxCell id="lane1" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#F2F5FA;strokeColor=none;strokeWidth=0;verticalAlign=middle;align=center;spacing=6;fontFamily=Calibri" vertex="1" parent="1"><mxGeometry x="30" y="328" width="1670" height="204" as="geometry"/></mxCell><mxCell id="lanetag1" value="&lt;span style=