olor:#5C6B7F;&quot;&gt;mean imputation → standardization&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C6D4E4;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;fontFamily=Calibri" vertex="1" parent="1"><mxGeometry x="350" y="154" width="300" height="132" as="geometry"/></mxCell><mxCell id="n02" value="&lt;span style=&quot;font-size:15px;color:#16202E;&quot;&gt;&lt;b&gt;Logistic regression&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#16202E;&quot;&gt;The coefficients are&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#16202E;&quot;&gt;the explanation.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#F2952B;&quot;&gt;No CDR input, so no target leakage.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C6D4E4;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;fontFamily=Calibri" vertex="1" parent="1"><mxGeometry x="690" y="154" width="310" height="132" as="geometry"/></mxCell><mxCell id="n03" value="&lt;span style=&quot;font-size:14px;color:#16202E;&quot;&gt;&lt;b&gt;top_drivers()&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#16202E;&quot;&gt;Ranks coefficient × value.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#16202E;&quot;&gt;Each driver reads as&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#16202E;&quot;&gt;“raises risk” or “lowers risk”.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C6D4E4;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;fontFamily=Calibri" vertex="1" parent="1"><mxGeometry x="1040" y="154" width="340" height="132" as="geometry"/></mxCell><mxCell id="n04" value="&lt;span style=&quot;font-size:12px;color:#2E9BD6;&quot;&gt;&lt;b&gt;score&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#FFFFFF;&quot;&gt;&lt;b&gt;P(at risk)&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#0E1B2E;strokeColor=#0E1B2E;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;fontFamily=Calibri" vertex="1" parent="1"><mxGeometry x="1430" y="154" width="230" height="132" as="geometry"/></mxCell><mxCell id="n10" value="&lt;span style=&quot;font-size:15px;color:#2E9BD6;&quot;&gt;&lt;b&gt;MRI&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5C6B7F;&quot;&gt;2D axial slice&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5C6B7F;&quot;&gt;3D volume (NIfTI)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C6D4E4;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;fontFamily=Calibri" vertex="1" parent="1"><mxGeometry x="60" y="364" width="250" height="132" as="geometry"/></mxCell><mxCell id="n11" value="&lt;span style=&quot;font-size:14px;color:#16202E;&quot;&gt;&lt;b&gt;Image preparation&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#16202E;&quot;&gt;Resize and normalize.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#16202E;&quot;&gt;3D: pool the central&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#16202E;&quot;&gt;axial slices (v1 approach).&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C6D4E4;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;fontFamily=Calibri" vertex="1" parent="1"><mxGeometry x="350" y="364" width="300" height="132" as="geometry"/></mxCell><mxCell id="n12" value="&lt;span style=&quot;font-size:15px;color:#16202E;&quot;&gt;&lt;b&gt;ResNet18&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#16202E;&quot;&gt;Frozen ImageNet backbone,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#16202E;&quot;&gt;retrained head.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#16202E;&quot;&gt;Softmax over severity.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C6D4E4;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;fontFamily=Calibri" vertex="1" parent="1"><mxGeometry x="690" y="364" width="310" height="132" as="geometry"/></mxCell><mxCell id="n13" value="&lt;span style=&quot;font-size:14px;color:#16202E;&quot;&gt;&lt;b&gt;Grad-CAM&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#16202E;&quot;&gt;Pixel attribution for the&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#16202E;&quot;&gt;winning class, drawn on&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#16202E;&quot;&gt;the scan itself.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C6D4E4;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;fontFamily=Calibri" vertex="1" parent="1"><mxGeometry x="1040" y="364" width="340" height="132" as="geometry"/></mxCell><mxCell id="n14" value="&lt;span style=&quot;font-size:12px;color:#2E9BD6;&quot;&gt;&lt;b&gt;score&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#FFFFFF;&quot;&gt;&lt;b&gt;1 − P(Non Demented)&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#0E1B2E;strokeColor=#0E1B2E;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;fontFamily=Calibri" vertex="1" parent="1"><mxGeometry x="1430" y="364" width="230" height="132" as="geometry"/></mxCell><mxCell id="n20" value="&lt;span style=&quot;font-size:15px;color:#3FA34D;&quot;&gt;&lt;b&gt;EEG&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5C6B7F;&quot;&gt;Resting-state recording&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5C6B7F;&quot;&gt;(ds004504)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C6D4E4;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;fontFamily=Calibri" vertex="1" parent="1"><mxGeometry x="60" y="574" width="250" height="132" as="geometry"/></mxCell><mxCell id="n21" value="&lt;span style=&quot;font-size:14px;color:#16202E;&quot;&gt;&lt;b&gt;Band-power features&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#16202E;&quot;&gt;Relative power in delta, theta,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#16202E;&quot;&gt;alpha, beta and gamma,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#16202E;&quot;&gt;plus 2 slowing ratios.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C6D4E4;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;fontFamily=Calibri" vertex="1" parent="1"><mxGeometry x="350" y="574" width="300" height="132" as="geometry"/></mxCell><mxCell id="n22" value="&lt;span style=&quot;font-size:15px;color:#16202E;&quot;&gt;&lt;b&gt;Logistic regression&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#16202E;&quot;&gt;Standardized band features&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#16202E;&quot;&gt;against a healthy cohort&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#16202E;&quot;&gt;and an AD cohort.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C6D4E4;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;fontFamily=Calibri" vertex="1" parent="1"><mxGeometry x="690" y="574" width="310" height="132" as="geometry"/></mxCell><mxCell id="n23" value="&lt;span style=&quot;font-size:14px;color:#16202E;&quot;&gt;&lt;b&gt;Band contribution&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#16202E;&quot;&gt;Score decomposed by&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#16202E;&quot;&gt;frequency, plus a scalp&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#16202E;&quot;&gt;topomap of the slowing.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C6D4E4;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;fontFamily=Calibri" vertex="1" parent="1"><mxGeometry x="1040" y="574" width="340" height="132" as="geometry"/></mxCell><mxCell id="n24" value="&lt;span style=&quot;font-size:12px;color:#2E9BD6;&quot;&gt;&lt;b&gt;score&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#FFFFFF;&quot;&gt;&lt;b&gt;P(AD pattern)&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#0E1B2E;strokeColor=#0E1B2E;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;fontFamily=Calibri" vertex="1" parent="1"><mxGeometry x="1430" y="574" width="230" height="132" as="geometry"/></mxCell><mxCell id="fusion" value="&lt;span style=&quot;font-size:12px;color:#2E9BD6;&quot;&gt;&lt;b&gt;FUSION&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#FFFFFF;&quot;&gt;&lt;b&gt;Logarithmic opinion pool&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#CFE0F2;&quot;&gt;logit(P_fused) = Σ rᵢ · logit(pᵢ) / Σ rᵢ&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#CFE0F2;&quot;&gt;P_fused = sigmoid( logit(P_fused) )&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#FFFFFF;&quot;&gt;A confident modality (p near 0 or 1)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#FFFFFF;&quot;&gt;moves the result strongly. An uncertain&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#FFFFFF;&quot;&gt;modality (p ≈ 0.5) moves it very little.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#F2952B;&quot;&gt;&lt;b&gt;rᵢ = 1.0 for every modality, not tuned.&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#0E1B2E;strokeColor=#0E1B2E;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;fontFamily=Calibri" vertex="1" parent="1"><mxGeometry x="1730" y="250" width="440" height="360" as="geometry"/></mxCell><mxCell id="out" value="&lt;span style=&quot;font-size:12px;color:#1B5FA8;&quot;&gt;&lt;b&gt;INTEGRATED PROGNOSIS&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#16202E;&quot;&gt;&lt;b&gt;score  ·  label  ·  drivers&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#5C6B7F;&quot;&gt;One call: predict(...) returns all three.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#E7EEF7;strokeColor=#2E9BD6;strokeWidth=2;verticalAlign=middle;align=center;spacing=6;fontFamily=Calibri" vertex="1" parent="1"><mxGeometry x="1730" y="650" width="440" height="128" as="geometry"/></mxCell><mxCell id="llm" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#F2F5FA;strokeColor=none;strokeWidth=0;verticalAlign=middle;align=center;spacing=6;fontFamily=Calibri" vertex="1" parent="1"><mxGeometry x="30" y="790" width="2140" height="96" as="geometry"/></mxCell><mxCell id="llmtag" value="&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;&lt;b&gt;LLM NARRATIVE LAYER — IT DRAFTS, IT DOES NOT DECIDE&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=26;whiteSpace=wrap;html=1;fillColor=#F2952B;strokeColor=none;strokeWidth=0;verticalAlign=middle;align=center;spacing=6;fontFamily=Calibri" vertex="1" parent="1"><mxGeometry x="46" y="802" width="300" height="26" as="geometry"/></mxCell><mxCell id="chip0" value="&lt;span style=&quot;font-size:11.5px;color:#16202E;&quot;&gt;&lt;b&gt;Radiology-style report&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5C6B7F;&quot;&gt;(vision LLM on t