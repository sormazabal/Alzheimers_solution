# Copy to .env and fill in ONE provider. .env is gitignored.
# Optional: force a provider (anthropic, openai, gemini, groq, ollama, bedrock).
# If unset, the first provider with a key below is used; falls back to Anthropic.
LLM_PROVIDER=groq

# Anthropic (default fallback)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (local, no key)
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434/v1

# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BEDROCK_MODEL=amazon.nova-lite-v1:0
